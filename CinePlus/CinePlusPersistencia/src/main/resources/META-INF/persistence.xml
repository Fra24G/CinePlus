<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="CinePlusPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.cineplus.entidades.Usuario</class>
        <class>com.cineplus.entidades.Membresia</class>
        <class>com.cineplus.entidades.Cine</class>
        <class>com.cineplus.entidades.Pelicula</class>
        <class>com.cineplus.entidades.Resena</class>
        <class>com.cineplus.entidades.Sala</class>
        <class>com.cineplus.entidades.Asiento</class>
        <class>com.cineplus.entidades.Funcion</class>
        <class>com.cineplus.entidades.Compra</class>
        <class>com.cineplus.entidades.Boleto</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/cineplus?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>